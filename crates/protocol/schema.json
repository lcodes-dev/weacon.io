{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "One message on the wire. A reply carries the `id` of the request it answers.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "$ref": "#/$defs/Hello",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "$ref": "#/$defs/Welcome",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "$ref": "#/$defs/ErrorBody",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "receipt"
        }
      },
      "$ref": "#/$defs/Receipt",
      "required": [
        "type"
      ]
    },
    {
      "description": "What a run reported, from the core to clients that have the capability `run.stream`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "run"
        }
      },
      "$ref": "#/$defs/RunUpdate",
      "required": [
        "type"
      ]
    }
  ],
  "required": [
    "id"
  ],
  "$defs": {
    "AgentSession": {
      "description": "An agent's own id for a conversation, a lowercase UUID, which resumes it later.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "App": {
      "description": "A program, such as `weacon-desktop`, and the exact build it is.",
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "commit"
      ]
    },
    "Capability": {
      "description": "A feature a peer supports, such as `chat.send`, named like a [`Code`]. A peer keeps the ones\nit doesn't know, so a newer peer's list still parses.",
      "$ref": "#/$defs/Code"
    },
    "Code": {
      "description": "A dotted code such as `store.full`: two or more lowercase words joined by dots. It names\nerrors, and capabilities too.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "retryable": {
          "description": "Whether the same request can succeed if sent again later.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ]
    },
    "Hello": {
      "description": "The first message on every connection, from the side that connects.",
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol",
        "app"
      ]
    },
    "Outcome": {
      "description": "Where an accepted command stands. It ends `completed`, `interrupted`, `failed` or `unknown`.\n`unknown` means it may or may not have run, as when a restart cut it off; the client must not\nsend it again under a new id.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "Receipt": {
      "description": "The daemon's word on a command, sent when it is accepted and again when it ends.",
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ],
      "required": [
        "request"
      ]
    },
    "RequestId": {
      "description": "A command's id, chosen by the client and kept across reconnects and retries. Sending the\nsame id again returns the first receipt instead of repeating the work; the same id with\ndifferent content is refused with the error `request.conflict`.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "RunEvent": {
      "description": "What an agent's run reports, in order. Each turn ends with `finished`.",
      "oneOf": [
        {
          "description": "The agent's conversation, to resume it later.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "started"
            },
            "session": {
              "$ref": "#/$defs/AgentSession"
            }
          },
          "required": [
            "event",
            "session"
          ]
        },
        {
          "description": "More of the text block being written; the [`RunEvent::Text`] that follows replaces it.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "text_delta"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "tool_call"
            },
            "input": true,
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "call",
            "tool",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "tool_done"
            },
            "failed": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "call",
            "failed"
          ]
        },
        {
          "description": "The agent asks to use a tool and waits for a [`PermissionAnswer`].",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "permission_asked"
            },
            "input": true,
            "prompt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "run": {
              "$ref": "#/$defs/RunId"
            },
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "prompt",
            "tool",
            "input"
          ]
        },
        {
          "description": "The agent no longer waits for the answer to `prompt`.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "permission_withdrawn"
            },
            "prompt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "run": {
              "$ref": "#/$defs/RunId"
            }
          },
          "required": [
            "event",
            "run",
            "prompt"
          ]
        },
        {
          "description": "Ends the turn and withdraws any prompt still waiting.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "finished"
            },
            "outcome": {
              "$ref": "#/$defs/Outcome"
            }
          },
          "required": [
            "event",
            "outcome"
          ]
        }
      ]
    },
    "RunId": {
      "description": "The core's id for one run of an agent process, 1–64 ASCII letters, digits, `-` or `_`.\nPrompts carry it, so an answer only ever reaches the run that asked.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "RunUpdate": {
      "description": "One event of the run `run`, in the order the run reported it.",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/RunEvent"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "run",
        "event"
      ]
    },
    "Welcome": {
      "description": "The answer to a [`Hello`] that speaks the same protocol.",
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        }
      },
      "required": [
        "app"
      ]
    }
  }
}
