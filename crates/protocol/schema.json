{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "One message on the wire. A reply carries the `id` of the request it answers.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "$ref": "#/$defs/Hello",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "$ref": "#/$defs/Welcome",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "$ref": "#/$defs/ErrorBody",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "receipt"
        }
      },
      "$ref": "#/$defs/Receipt",
      "required": [
        "type"
      ]
    },
    {
      "description": "An element picked in Chrome, from the extension's host to a core that offers element.pick.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pick"
        }
      },
      "$ref": "#/$defs/Pick",
      "required": [
        "type"
      ]
    },
    {
      "description": "What a run reported, from the core to clients that have the capability `run.stream`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "run"
        }
      },
      "$ref": "#/$defs/RunUpdate",
      "required": [
        "type"
      ]
    },
    {
      "description": "A change to a workspace, from the server to clients that have the capability\n`workspace.feed`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "workspace"
        }
      },
      "$ref": "#/$defs/WorkspaceUpdate",
      "required": [
        "type"
      ]
    },
    {
      "description": "A log record from a client, sent only to a peer that offers `log.forward`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "log"
        }
      },
      "$ref": "#/$defs/ClientLog",
      "required": [
        "type"
      ]
    },
    {
      "description": "What a person asks of a chat's agent, from a client to a core that offers `chat.send`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat_command"
        }
      },
      "$ref": "#/$defs/ChatCommand",
      "required": [
        "type"
      ]
    },
    {
      "description": "A committed event of a chat, from the core to a client that subscribed under\n`chat.events`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        }
      },
      "$ref": "#/$defs/ChatUpdate",
      "required": [
        "type"
      ]
    },
    {
      "description": "A question about a chat's log, from a client to a core that offers `chat.events`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat_query"
        }
      },
      "$ref": "#/$defs/ChatQuery",
      "required": [
        "type"
      ]
    },
    {
      "description": "The core's answer to a [`ChatQuery`], or its word that the client missed events, to a\nclient that has `chat.events`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat_answer"
        }
      },
      "$ref": "#/$defs/ChatAnswer",
      "required": [
        "type"
      ]
    }
  ],
  "required": [
    "id"
  ],
  "$defs": {
    "AgentSession": {
      "description": "An agent's own id for a conversation, a lowercase UUID, which resumes it later.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "App": {
      "description": "A program, such as `weacon-core`, and the exact build it is.",
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "commit"
      ]
    },
    "Capability": {
      "description": "A feature a peer supports, such as `chat.send`, named like a [`Code`]. A peer keeps the ones\nit doesn't know, so a newer peer's list still parses.",
      "$ref": "#/$defs/Code"
    },
    "ChatAction": {
      "oneOf": [
        {
          "description": "Starts a turn with `text`, or queues it behind the turn that is running.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prompt"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "description": "Answers a permission prompt of one of the chat's runs.",
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "#/$defs/PermissionAnswer"
            },
            "kind": {
              "type": "string",
              "const": "permission"
            }
          },
          "required": [
            "kind",
            "answer"
          ]
        },
        {
          "description": "Stops the turn that is running.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "interrupt"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ChatAnswer": {
      "type": "object",
      "properties": {
        "answer": {
          "$ref": "#/$defs/ChatAnswerKind"
        },
        "chat": {
          "$ref": "#/$defs/ChatId"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace",
        "chat",
        "answer"
      ]
    },
    "ChatAnswerKind": {
      "oneOf": [
        {
          "description": "The client missed events and its subscription is over: fetch a snapshot, then subscribe\nafter its `seq`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "events_lost"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The chat as of `seq`: its runs, where in the log the permission prompts still waiting\nare, and its latest events, as many as fit one frame. A `window` fetches a prompt that\nisn't among them.",
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChatEntry"
              }
            },
            "kind": {
              "type": "string",
              "const": "snapshot"
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RunStatus"
              }
            },
            "seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "waiting": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "seq",
            "runs",
            "waiting",
            "events"
          ]
        },
        {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChatEntry"
              }
            },
            "kind": {
              "type": "string",
              "const": "window"
            }
          },
          "required": [
            "kind",
            "events"
          ]
        }
      ]
    },
    "ChatCommand": {
      "description": "The core answers with receipts under `request`.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ChatAction"
        },
        "chat": {
          "$ref": "#/$defs/ChatId"
        },
        "request": {
          "$ref": "#/$defs/RequestId"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "request",
        "workspace",
        "chat",
        "action"
      ]
    },
    "ChatEntry": {
      "description": "An event and its place in its chat's log: `seq` starts at 1 and grows by one.",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/ChatEvent"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "seq",
        "event"
      ]
    },
    "ChatEvent": {
      "oneOf": [
        {
          "description": "A person's prompt, accepted under `request`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prompt"
            },
            "request": {
              "$ref": "#/$defs/RequestId"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "request",
            "text"
          ]
        },
        {
          "description": "Where a chat command stands; written once per state.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "receipt"
            },
            "receipt": {
              "$ref": "#/$defs/Receipt"
            }
          },
          "required": [
            "kind",
            "receipt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "run"
            },
            "update": {
              "$ref": "#/$defs/RunUpdate"
            }
          },
          "required": [
            "kind",
            "update"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "run_status"
            },
            "status": {
              "$ref": "#/$defs/RunStatus"
            }
          },
          "required": [
            "kind",
            "status"
          ]
        }
      ]
    },
    "ChatId": {
      "description": "A chat in a workspace, 1–64 ASCII letters, digits, `-` or `_`.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "ChatQuery": {
      "description": "The answer is a [`ChatAnswer`], or for `subscribe` the [`ChatUpdate`]s themselves.",
      "type": "object",
      "properties": {
        "chat": {
          "$ref": "#/$defs/ChatId"
        },
        "query": {
          "$ref": "#/$defs/ChatQueryKind"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace",
        "chat",
        "query"
      ]
    },
    "ChatQueryKind": {
      "oneOf": [
        {
          "description": "Every event after `after`, then each new one as it is committed.",
          "type": "object",
          "properties": {
            "after": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "subscribe"
            }
          },
          "required": [
            "kind",
            "after"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "snapshot"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The latest events before `before`: at most `limit`, and fewer when they wouldn't fit\none frame.",
          "type": "object",
          "properties": {
            "before": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "window"
            },
            "limit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "before",
            "limit"
          ]
        }
      ]
    },
    "ChatUpdate": {
      "description": "Text deltas are never committed; they arrive only as run updates.",
      "type": "object",
      "properties": {
        "chat": {
          "$ref": "#/$defs/ChatId"
        },
        "entry": {
          "$ref": "#/$defs/ChatEntry"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace",
        "chat",
        "entry"
      ]
    },
    "ClientLog": {
      "description": "A log record from a client that has no log of its own, such as the web app: an event name and\ntyped ids. The receiver logs only events it knows, so no other text reaches its log.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "msg": {
          "$ref": "#/$defs/LogEvent"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "level",
        "msg"
      ]
    },
    "Code": {
      "description": "A dotted code such as `store.full`: two or more lowercase words joined by dots. It names\nerrors, and capabilities too.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "retryable": {
          "description": "Whether the same request can succeed if sent again later.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ]
    },
    "Hello": {
      "description": "The first message on every connection, from the side that connects.",
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol",
        "app"
      ]
    },
    "Level": {
      "oneOf": [
        {
          "description": "Very noisy.",
          "type": "string",
          "const": "trace"
        },
        {
          "description": "Developer detail.",
          "type": "string",
          "const": "debug"
        },
        {
          "description": "Lifecycle.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Failed and handled.",
          "type": "string",
          "const": "warn"
        },
        {
          "description": "A person needs to look.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "About to exit.",
          "type": "string",
          "const": "fatal"
        }
      ]
    },
    "LogEvent": {
      "description": "What happened, such as `run started`: one to four words of lowercase letters or `_`, one\nspace apart, at most 40 bytes; no digits, so ids and secrets can't be spelt in it.",
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z][a-z_]*( [a-z_]+){0,3}$"
    },
    "MemberId": {
      "description": "A member of a workspace, 1–64 ASCII letters, digits, `-` or `_`.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Outcome": {
      "description": "Where an accepted command stands. It ends `completed`, `interrupted`, `failed` or `unknown`.\n`unknown` means it may or may not have run, as when a restart cut it off; the client must not\nsend it again under a new id.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "PermissionAnswer": {
      "description": "A person's answer to a [`RunEvent::PermissionAsked`].",
      "type": "object",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "prompt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "run",
        "prompt",
        "allow"
      ]
    },
    "Pick": {
      "description": "An element someone picked on a local web page, sent to the core for a chat. The sender cuts\nthe HTML short and shrinks the screenshot so the message fits in one frame.",
      "type": "object",
      "properties": {
        "html": {
          "description": "The element's outer HTML.",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RequestId"
        },
        "screenshot_png": {
          "description": "What the element looked like: a PNG, base64-encoded. None when the page couldn't be\ncaptured.",
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "description": "A CSS selector that finds the element on the page.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "request",
        "url",
        "title",
        "selector",
        "html"
      ]
    },
    "Receipt": {
      "description": "The daemon's word on a command, sent when it is accepted and again when it ends.",
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ],
      "required": [
        "request"
      ]
    },
    "RequestId": {
      "description": "A command's id, chosen by the client and kept across reconnects and retries. Sending the\nsame id again returns the first receipt instead of repeating the work; the same id with\ndifferent content is refused with the error `request.conflict`.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "RunEvent": {
      "description": "What an agent's run reports, in order. Each turn ends with `finished`.",
      "oneOf": [
        {
          "description": "The agent's conversation, to resume it later.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "started"
            },
            "session": {
              "$ref": "#/$defs/AgentSession"
            }
          },
          "required": [
            "event",
            "session"
          ]
        },
        {
          "description": "More of the text block being written; the [`RunEvent::Text`] that follows replaces it.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "text_delta"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "tool_call"
            },
            "input": true,
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "call",
            "tool",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "tool_done"
            },
            "failed": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "call",
            "failed"
          ]
        },
        {
          "description": "The agent asks to use a tool and waits for a [`PermissionAnswer`].",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "permission_asked"
            },
            "input": true,
            "prompt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "run": {
              "$ref": "#/$defs/RunId"
            },
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "run",
            "prompt",
            "tool",
            "input"
          ]
        },
        {
          "description": "The agent no longer waits for the answer to `prompt`.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "permission_withdrawn"
            },
            "prompt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "run": {
              "$ref": "#/$defs/RunId"
            }
          },
          "required": [
            "event",
            "run",
            "prompt"
          ]
        },
        {
          "description": "Ends the turn and withdraws any prompt still waiting.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "finished"
            },
            "outcome": {
              "$ref": "#/$defs/Outcome"
            }
          },
          "required": [
            "event",
            "outcome"
          ]
        }
      ]
    },
    "RunId": {
      "description": "The core's id for one run of an agent process, 1–64 ASCII letters, digits, `-` or `_`.\nPrompts carry it, so an answer only ever reaches the run that asked.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "RunState": {
      "oneOf": [
        {
          "description": "The agent process is starting.",
          "type": "string",
          "const": "starting"
        },
        {
          "description": "On a turn.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "On a turn, waiting for a person to answer a permission prompt.",
          "type": "string",
          "const": "waiting"
        },
        {
          "description": "Between turns, with its process alive.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "Its process was stopped; the next prompt resumes the same agent session in a new run.",
          "type": "string",
          "const": "sleeping"
        },
        {
          "description": "Over for good.",
          "type": "string",
          "const": "ended"
        }
      ]
    },
    "RunStatus": {
      "description": "Where a run stands, as its chat's log records it.",
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "run",
        "state"
      ]
    },
    "RunUpdate": {
      "description": "One event of the run `run`, in the order the run reported it.",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/RunEvent"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "run",
        "event"
      ]
    },
    "Welcome": {
      "description": "The answer to a [`Hello`] that speaks the same protocol.",
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        }
      },
      "required": [
        "app"
      ]
    },
    "WorkspaceChange": {
      "description": "What changed in a workspace.",
      "oneOf": [
        {
          "description": "A member signed in for the first time.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "member_joined"
            },
            "member": {
              "$ref": "#/$defs/MemberId"
            }
          },
          "required": [
            "kind",
            "member"
          ]
        }
      ]
    },
    "WorkspaceId": {
      "description": "A workspace on the server, 1–64 ASCII letters, digits, `-` or `_`.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "WorkspaceUpdate": {
      "description": "One change to `workspace`. `seq` grows strictly within a workspace, and a feed opened with\n`since=N` sends every change after `N`.",
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/WorkspaceChange"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace",
        "seq",
        "change"
      ]
    }
  }
}
