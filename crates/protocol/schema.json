{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "One message on the wire. A reply carries the `id` of the request it answers.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "$ref": "#/$defs/Hello",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "$ref": "#/$defs/Welcome",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "$ref": "#/$defs/ErrorBody",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "receipt"
        }
      },
      "$ref": "#/$defs/Receipt",
      "required": [
        "type"
      ]
    }
  ],
  "required": [
    "id"
  ],
  "$defs": {
    "App": {
      "description": "A program, such as `weacon-desktop`, and the exact build it is.",
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "commit"
      ]
    },
    "Capability": {
      "description": "A feature a peer supports, such as `chat.send`, named like a [`Code`]. A peer keeps the ones\nit doesn't know, so a newer peer's list still parses.",
      "$ref": "#/$defs/Code"
    },
    "Code": {
      "description": "A dotted code such as `store.full`: two or more lowercase words joined by dots. It names\nerrors, and capabilities too.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "retryable": {
          "description": "Whether the same request can succeed if sent again later.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ]
    },
    "Hello": {
      "description": "The first message on every connection, from the side that connects.",
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol",
        "app"
      ]
    },
    "Receipt": {
      "description": "The daemon's word on a command, sent when it is accepted and again when it ends.",
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ],
      "required": [
        "request"
      ]
    },
    "RequestId": {
      "description": "A command's id, chosen by the client and kept across reconnects and retries. Sending the\nsame id again returns the first receipt instead of repeating the work; the same id with\ndifferent content is refused with the error `request.conflict`.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Welcome": {
      "description": "The answer to a [`Hello`] that speaks the same protocol.",
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        }
      },
      "required": [
        "app"
      ]
    }
  }
}
