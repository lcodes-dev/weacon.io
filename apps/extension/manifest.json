{
  "manifest_version": 3,
  "name": "Weacon",
  "description": "Pick an element on a local page and send it to Weacon.",
  "version": "set by tools/build.ts",
  "version_name": "set by tools/build.ts",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Pick an element to send to Weacon" }
}
