  "query": "SELECT b.project_id, p.team_id, p.repo AS \"repo!\", b.name, b.head_sha AS \"head_sha!\"\n           FROM branches b JOIN projects p ON p.id = b.project_id\n           WHERE b.head_sha IS NOT NULL AND b.head_sha IS NOT b.commit_sha AND b.error IS NULL",
